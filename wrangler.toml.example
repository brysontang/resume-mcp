# Copy this to wrangler.toml and fill in your values
name = "resume-mcp"
main = "src/index.ts"
compatibility_date = "2024-12-01"
compatibility_flags = ["nodejs_compat"]

# Your custom domain (optional)
# routes = [
#   { pattern = "mcp.yourdomain.dev", custom_domain = true }
# ]

# KV namespace for the profile cache, sessions, and rate limits
# Create with: wrangler kv:namespace create "GUESTBOOK"
# [[kv_namespaces]]
# binding = "GUESTBOOK"
# id = "your-kv-namespace-id"

# D1 database the guestbook lives in, shared with your site's guestbook API.
# Needs a `guestbook` table: name, message, ip_hash, created_at, agent_id, contact
# (see brysontang/bryt12.github.io workers/schema.sql)
# [[d1_databases]]
# binding = "GUESTBOOK_DB"
# database_name = "your-guestbook-db"
# database_id = "your-d1-database-id"

# Email notifications for the request_time perk. Needs Email Routing enabled
# on your domain, with destination_address verified there first.
# [[send_email]]
# name = "NOTIFY_EMAIL"
# destination_address = "you@yourdomain.dev"

# Secrets (optional):
#   wrangler secret put IP_SALT      # same salt as your site's guestbook API, so ip_hash values line up
#   wrangler secret put CALCOM_LINK  # booking link, only ever sent to requests you approve

# Environment variables (optional)
# [vars]
# CORS_ORIGIN = "https://yourdomain.dev"
# NOTIFY_TO = "you@yourdomain.dev"  # must match the send_email destination_address
